APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Produksi: isi "single,slack" supaya error juga terkirim ke Slack. Tanpa itu error hanya
# mendarat di storage/logs yang tidak ada yang membacanya, dan dengan APP_DEBUG=false kamu
# tidak akan tahu ada yang rusak sampai ada yang mengeluh.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Webhook Slack incoming. Kosong = channel slack tidak dipakai. Level ambangnya mengikuti
# LOG_LEVEL, jadi di produksi setel LOG_LEVEL=warning supaya Slack tidak dibanjiri info.
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# === Perawatan terjadwal (lihat routes/console.php; butuh cron `php artisan schedule:run`) ===
# Path mysqldump. Di Laragon binernya tidak ada di PATH, jadi tulis lengkap:
# MYSQLDUMP_PATH="C:/laragon/bin/mysql/mysql-8.0.30-winx64/bin/mysqldump.exe"
MYSQLDUMP_PATH=mysqldump
# Umur arsip backup sebelum dibuang. 0 = simpan selamanya.
BACKUP_SIMPAN_HARI=14
# Umur baris sebelum dipangkas `model:prune`. 0 = jangan pangkas tabel itu sama sekali.
RETENSI_AUDIT_LOG_HARI=730
RETENSI_NOTIFIKASI_HARI=90
